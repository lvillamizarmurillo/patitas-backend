{
  "name": "patitas-backend",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server.js",
    "start:prod": "node scripts/start-prod.js",
    "dev": "nodemon -L server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "create-admin": "node scripts/create-admin.js",
    "alerts:send": "node scripts/send-search-alerts.js",
    "smtp:test": "node scripts/test-smtp.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/global-setup.js",
    "setupFiles": ["./tests/setup-env.js"],
    "setupFilesAfterEnv": ["./tests/after-env.js"],
    "testTimeout": 30000
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@aws-sdk/client-sqs": "^3.1142.0",
    "@aws-sdk/s3-request-presigner": "^3.1142.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "puppeteer-core": "^25.12.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0"
  }
}
