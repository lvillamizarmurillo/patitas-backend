# ─── Copia este archivo a .env SOLO para desarrollo local. En Dokploy las variables van en el panel. ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos: usa DATABASE_URL (Dokploy/Railway/RDS) o las variables sueltas (docker-compose local)
DATABASE_URL=
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=patitas_db
DB_SSL=false

# Genera uno con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Orígenes permitidos separados por coma (en producción solo https://)
CORS_ORIGINS=http://localhost:5173
# Base de los enlaces que viajan en los correos (recuperación de contraseña)
FRONTEND_URL=http://localhost:5173
# Saltos de proxy confiables: 1 = Dokploy/Traefik; 2 = Cloudflare delante de Traefik
TRUST_PROXY=1
# strict si front y API comparten dominio (app.x.com + api.x.com); none si son dominios distintos
COOKIE_SAMESITE=strict

# Imágenes: cloudinary (hoy) | s3 (AWS) | local (solo desarrollo)
STORAGE_DRIVER=cloudinary
CLOUDINARY_URL=
AWS_REGION=us-east-1
S3_BUCKET=
CDN_DOMAIN=

# Correo (vacío SMTP_HOST = no se envían correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@patitas.app
# Nombre que firma los correos
APP_NAME=PuppyMarket
# Destino del formulario "Escríbenos"; vacío = los mensajes solo se guardan en BD
SUPPORT_EMAIL=

# Alertas de búsqueda: cada cuántos minutos corre el job (0 = apagado) y horas mínimas entre correos por alerta
SEARCH_ALERTS_INTERVAL_MINUTES=60
SEARCH_ALERTS_COOLDOWN_HOURS=24

# Job de citas: recordatorio del día, vencimiento de pendientes y aviso de confirmadas sin cerrar
APP_TIMEZONE=America/Bogota
APPOINTMENT_JOBS_INTERVAL_MINUTES=15
APPOINTMENT_REMINDER_FROM_HOUR=7
APPOINTMENT_OVERDUE_HOURS=24

# Veterinarias de entrega: ciudades permitidas (separadas por coma)
CLINIC_CITIES=Bucaramanga,Floridablanca,Piedecuesta
# Agendamiento: días con horarios que se ofrecen y hasta cuántos días adelante se buscan
BOOKING_DAYS=3
BOOKING_SEARCH_DAYS=21

# Comisión sobre el precio del vendedor (0.17 = 17 %)
COMMISSION_RATE=0.17
# Pagos con Wompi (las tres o ninguna; sin ellas el pago en línea queda deshabilitado). Sandbox: pub_test_...
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Minutos para pagar la reserva antes de que se cancele sola
PAYMENT_EXPIRY_MINUTES=30

# Producción: aplicar migraciones al arrancar el contenedor (default true)
RUN_MIGRATIONS=true
