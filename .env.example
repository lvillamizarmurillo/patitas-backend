NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Usa DATABASE_URL (Dokploy/Railway/RDS) o las variables sueltas
DATABASE_URL=
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=patitas_db
DB_SSL=false

JWT_SECRET=
JWT_EXPIRES_IN=15m

CORS_ORIGINS=http://localhost:5173
# Base de los enlaces que viajan en los correos (ej. recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

STORAGE_DRIVER=cloudinary
CLOUDINARY_URL=
AWS_REGION=us-east-1
S3_BUCKET=
CDN_DOMAIN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@patitas.app
# Destino del formulario "Escríbenos"; vacío = los mensajes solo se guardan en BD
SUPPORT_EMAIL=
